# Copy to .env and edit. All optional for local use.
DB_PASSWORD=rootpass
JWT_SECRET=put-a-long-random-string-here-at-least-64-characters-long-xxxxxxxxxxxxxxxx
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8080/mywallet
# true = no email OTP at sign-up. Set false + fill Gmail App Password to enable real verification emails.
SKIP_EMAIL_VERIFICATION=true
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
